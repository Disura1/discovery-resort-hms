# Copy this file to .env in the project root before running `docker compose up`.
# docker-compose.yml reads these values to configure the backend service.

POSTGRES_PASSWORD=change_me_in_production
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_at_least_32_chars
JWT_GUEST_ACCESS_SECRET=replace_with_yet_another_long_random_secret
JWT_GUEST_REFRESH_SECRET=replace_with_yet_another_different_long_random_secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Grand Lotus Hotel <no-reply@yourhotel.com>
SMTP_SECURE=false
STRIPE_SECRET_KEY=sk_live_or_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
CORS_ORIGIN=http://localhost:8080
